# Secrets — never commit these
.env
.env.*
!.env.example

# Virtual environment (recreated by `uv sync`)
.venv/

# NOTE: uv.lock, pyproject.toml and .python-version are intentionally NOT
# ignored — they are what make a fresh clone reproducible.

# Editor
.vscode/
.idea/

# OS
.DS_Store

# Python
__pycache__/
*.py[cod]

# ADK runtime artifacts (local session state)
.adk/
*.db

# Output written by research_agent's report_writer_tool
*_report.txt
report.txt
