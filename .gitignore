# Secrets — never commit these
.env
.env.*
!.env.example

# Virtual environment (recreated by `uv sync`).
# uv.lock, pyproject.toml and .python-version stay tracked on purpose.
.venv/

# Editor
.vscode/
.idea/

# OS
.DS_Store

# Python
__pycache__/
*.py[cod]

# ADK runtime artifacts (local session state)
.adk/
*.db

# Output written by research_agent's report_writer_tool
*_report.txt
report.txt
