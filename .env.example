# Copy this file into each agent folder you want to run, renamed to `.env`.
#   cp .env.example day_trip_agent/.env
# Real `.env` files are gitignored — keys stay local.

# Required by every agent except research_agent.
OPENAI_API_KEY=sk-...

# Required only by research_agent, whose sub-agents run on Gemini.
GOOGLE_API_KEY=
